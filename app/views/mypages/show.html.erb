<h1>マイページ画面</h1>

<table class="profile-table">
  <tbody>
    <tr>
      <th>名前</th>
      <td><%= current_user.name %></td>
    </tr>

    <tr>
      <th>メールアドレス</th>
      <td><%= current_user.email %></td>
    </tr>
  </tbody>
</table>

<div class="logout-area">
  <%= button_to "ログアウト",
    destroy_user_session_path,
    method: :delete,
    class: "logout-link" %>
</div>